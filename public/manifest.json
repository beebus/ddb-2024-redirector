{
  "manifest_version": 3,
  "name": "DDB 2024 Redirector",
  "version": "1.0.0",
  "description": "Automatically redirects D&D Beyond 2014 (legacy) content links to their 2024 equivalents.",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["https://www.dndbeyond.com/*"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.dndbeyond.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/index.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
